# Test Makefile using system GCC as cross-compiler
CC = gcc
LD = ld
AS = as

CSRC = $(wildcard src/*.c)
ASRC = $(wildcard src/*.S)
OBJ = $(ASRC:.S=.o) $(CSRC:.c=.o)

KERNEL = kernel32.elf

CFLAGS = -Wall -Wextra -Werror -ffreestanding -fno-stack-protector -nostdlib \
         -fno-builtin -m32 -I src -fno-pie -fno-pic
LDFLAGS = -T linker.ld -nostdlib -m elf_i386
ASFLAGS = --32

%.o: %.S
	$(AS) $(ASFLAGS) -o $@ $<

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

all: $(KERNEL)

$(KERNEL): $(OBJ)
	$(LD) $(LDFLAGS) -o $@ $^

clean:
	rm -f $(KERNEL) $(OBJ)

.PHONY: all clean
